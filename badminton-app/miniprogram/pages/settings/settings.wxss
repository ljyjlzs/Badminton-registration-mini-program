.settings-page { padding: 24rpx; min-height: 100vh; }
.settings-loading { min-height: 100vh; display: flex; align-items: center; justify-content: center; }
.detail-section { background: rgba(255,255,255,0.96); padding: 30rpx 26rpx; border-radius: 30rpx; margin-bottom: 24rpx; border: 1rpx solid rgba(18,69,51,0.06); box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04); }
.section-title { display: block; font-size: 32rpx; font-weight: 700; color: #12332b; margin-bottom: 20rpx; }
.setting-row { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid rgba(18,69,51,0.06); }
.setting-row:last-child { border-bottom: none; }
.setting-label { font-size: 28rpx; color: #12332b; }
.setting-value { font-size: 28rpx; color: #0a7d52; font-weight: 600; }
.setting-value.disabled { color: #d64545; }
.status-tag { display: inline-flex; align-items: center; gap: 8rpx; padding: 8rpx 20rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 600; }
.status-on { background: linear-gradient(135deg,#ebfaf2 0%,#def3e8 100%); color: #0a7d52; }
.status-off { background: rgba(255,245,245,0.98); color: #d64545; }
.reason-tip { padding: 20rpx 24rpx; border-radius: 16rpx; background: linear-gradient(135deg,#fff6e8 0%,#ffecc4 100%); color: #c98517; font-size: 26rpx; margin-top: 16rpx; }
.empty-tip { padding: 32rpx; text-align: center; font-size: 26rpx; color: #8d9a95; }

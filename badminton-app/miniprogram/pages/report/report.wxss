.report-page { padding: 24rpx; min-height: 100vh; }
.report-loading { min-height: 100vh; display: flex; align-items: center; justify-content: center; }
.overview-card { background: linear-gradient(145deg,#f9fffc 0%,#eef7f3 100%); border-radius: 34rpx; padding: 32rpx 28rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 24rpx rgba(14,165,107,0.08); border: 1rpx solid rgba(14,165,107,0.12); }
.overview-kicker { font-size: 20rpx; letter-spacing: 5rpx; color: #0a7d52; margin-bottom: 12rpx; }
.activity-name { font-size: 40rpx; line-height: 1.25; color: #12332b; font-weight: 800; }
.overview-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 18rpx; margin-top: 20rpx; }
.overview-item { padding: 22rpx 20rpx; border-radius: 24rpx; background: rgba(255,255,255,0.85); border: 1rpx solid rgba(18,69,51,0.05); }
.overview-label { display: block; font-size: 22rpx; color: #8d9a95; margin-bottom: 8rpx; }
.overview-value { display: block; font-size: 27rpx; line-height: 1.5; color: #12332b; font-weight: 600; }
.detail-section { background: rgba(255,255,255,0.96); padding: 30rpx 26rpx; border-radius: 30rpx; margin-bottom: 24rpx; border: 1rpx solid rgba(18,69,51,0.06); box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04); }
.section-title { display: block; font-size: 32rpx; font-weight: 700; color: #12332b; margin-bottom: 20rpx; }
.top3-item { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx solid rgba(18,69,51,0.06); }
.top3-item:last-child { border-bottom: none; }
.top3-rank { width: 56rpx; height: 56rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 800; color: #fff; flex-shrink: 0; }
.rank-1 { background: linear-gradient(135deg,#f6a53b 0%,#ee8f1d 100%); }
.rank-2 { background: linear-gradient(135deg,#8d9a95 0%,#6b7b76 100%); }
.rank-3 { background: linear-gradient(135deg,#c98517 0%,#a67010 100%); }
.top3-info { flex: 1; }
.top3-name { font-size: 28rpx; font-weight: 600; color: #12332b; }
.top3-meta { font-size: 22rpx; color: #8d9a95; margin-top: 4rpx; }
.award-card { padding: 20rpx 24rpx; border-radius: 20rpx; background: linear-gradient(135deg,#f7fbf9 0%,#f1f7f4 100%); border: 1rpx solid rgba(18,69,51,0.05); margin-bottom: 12rpx; }
.award-title { font-size: 26rpx; font-weight: 700; color: #12332b; margin-bottom: 8rpx; }
.award-detail { font-size: 24rpx; color: #4a5e56; line-height: 1.6; }
.copy-block { margin-bottom: 16rpx; }
.copy-label { font-size: 24rpx; color: #8d9a95; margin-bottom: 8rpx; }
.copy-text { font-size: 26rpx; color: #12332b; line-height: 1.6; padding: 16rpx 20rpx; border-radius: 16rpx; background: rgba(244,247,246,0.96); word-break: break-all; }
.btn-copy { font-size: 22rpx; color: #0ea56b; padding: 8rpx 16rpx; border-radius: 999rpx; background: rgba(231,247,239,0.96); border: none; margin-top: 8rpx; }
.btn-generate { width: 100%; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 999rpx; font-size: 30rpx; font-weight: 700; background: linear-gradient(135deg,#536ff3 0%,#6b53c5 100%); color: #fff; border: none; margin-top: 16rpx; }
.empty-tip { padding: 32rpx; text-align: center; font-size: 26rpx; color: #8d9a95; }

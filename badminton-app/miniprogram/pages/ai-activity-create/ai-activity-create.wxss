.ai-create-page { padding: 24rpx; min-height: 100vh; }
.detail-section { background: rgba(255,255,255,0.96); padding: 30rpx 26rpx; border-radius: 30rpx; margin-bottom: 24rpx; border: 1rpx solid rgba(18,69,51,0.06); box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04); }
.section-title { display: block; font-size: 32rpx; font-weight: 700; color: #12332b; margin-bottom: 20rpx; }
.ai-input { width: 100%; min-height: 160rpx; border: 2rpx solid rgba(18,69,51,0.12); border-radius: 16rpx; padding: 20rpx; font-size: 28rpx; }
.btn-parse { width: 100%; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 999rpx; font-size: 30rpx; font-weight: 700; background: linear-gradient(135deg,#536ff3 0%,#6b53c5 100%); color: #fff; border: none; margin-top: 20rpx; }
.btn-parse:disabled { opacity: 0.5; }
.form-group { margin-bottom: 20rpx; }
.form-label { display: block; font-size: 26rpx; color: #8d9a95; margin-bottom: 8rpx; }
.form-input { width: 100%; height: 80rpx; border: 2rpx solid rgba(18,69,51,0.12); border-radius: 16rpx; padding: 0 20rpx; font-size: 28rpx; }
.form-input.missing { border-color: #c98517; background: rgba(255,246,232,0.5); }
.missing-tip { font-size: 22rpx; color: #c98517; margin-top: 4rpx; }
.type-selector { display: flex; gap: 12rpx; }
.type-item { flex: 1; padding: 16rpx; border-radius: 16rpx; background: rgba(244,247,246,0.96); border: 2rpx solid rgba(18,69,51,0.06); text-align: center; font-size: 26rpx; color: #4a5e56; }
.type-item.selected { background: linear-gradient(135deg,#0ea56b,#0bc278); color: #fff; border-color: transparent; }
.btn-create { width: 100%; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 999rpx; font-size: 30rpx; font-weight: 700; background: linear-gradient(135deg,#0ea56b 0%,#0bc278 100%); color: #fff; border: none; margin-top: 20rpx; }
.btn-create:disabled { opacity: 0.5; }
.empty-tip { padding: 32rpx; text-align: center; font-size: 26rpx; color: #8d9a95; }

.policy-page {
  min-height: 100vh;
  padding-bottom: 64rpx;
}
.policy-header {
  background: var(--primary-gradient-strong);
  padding: 56rpx 40rpx 44rpx;
  border-radius: 0 0 36rpx 36rpx;
  box-shadow: var(--shadow-md);
}
.policy-header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 14rpx;
}
.policy-header-date {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}
.policy-body {
  padding: 36rpx 32rpx;
}
.policy-section {
  margin-bottom: 40rpx;
}
.policy-section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--border-light);
}
.policy-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.85;
  color: var(--text-secondary);
  margin-bottom: 14rpx;
}

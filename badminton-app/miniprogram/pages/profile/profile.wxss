.profile-page { padding: 24rpx; min-height: 100vh; }
.profile-loading { min-height: 100vh; display: flex; align-items: center; justify-content: center; }
.profile-card { background: linear-gradient(145deg,#f9fffc 0%,#eef7f3 100%); border-radius: 34rpx; padding: 40rpx 28rpx; margin-bottom: 24rpx; display: flex; align-items: center; gap: 28rpx; box-shadow: 0 8rpx 24rpx rgba(14,165,107,0.08); border: 1rpx solid rgba(14,165,107,0.12); }
.profile-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 48rpx; font-weight: 700; color: #fff; background: linear-gradient(135deg,#0ea56b,#0bc278); flex-shrink: 0; }
.profile-info { flex: 1; min-width: 0; }
.profile-name { font-size: 36rpx; font-weight: 700; color: #12332b; }
.profile-level { font-size: 24rpx; color: #8d9a95; margin-top: 6rpx; }
.profile-rating { font-size: 24rpx; color: #0a7d52; margin-top: 4rpx; }
.stats-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16rpx; margin-bottom: 24rpx; }
.stat-item { padding: 24rpx 16rpx; border-radius: 24rpx; background: rgba(255,255,255,0.96); border: 1rpx solid rgba(18,69,51,0.06); text-align: center; }
.stat-value { display: block; font-size: 36rpx; font-weight: 800; color: #12332b; }
.stat-label { display: block; font-size: 22rpx; color: #8d9a95; margin-top: 6rpx; }
.detail-section { background: rgba(255,255,255,0.96); padding: 30rpx 26rpx; border-radius: 30rpx; margin-bottom: 24rpx; border: 1rpx solid rgba(18,69,51,0.06); box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04); }
.section-title { display: block; font-size: 32rpx; font-weight: 700; color: #12332b; margin-bottom: 20rpx; }
.badge-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.badge-item { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 24rpx; border-radius: 20rpx; background: linear-gradient(135deg,#fff7e9 0%,#ffecc2 100%); }
.badge-icon { font-size: 36rpx; }
.badge-name { font-size: 26rpx; font-weight: 600; color: #12332b; }
.badge-date { font-size: 20rpx; color: #8d9a95; }
.empty-tip { padding: 32rpx; text-align: center; font-size: 26rpx; color: #8d9a95; }
.activity-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid rgba(18,69,51,0.06); }
.activity-item:last-child { border-bottom: none; }
.act-name { font-size: 28rpx; font-weight: 600; color: #12332b; }
.act-meta { font-size: 22rpx; color: #8d9a95; margin-top: 6rpx; }
.act-status { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 999rpx; }
.act-status.finished { background: rgba(244,247,246,0.96); color: #8d9a95; }
.act-status.registering { background: linear-gradient(135deg,#ebfaf2 0%,#def3e8 100%); color: #0a7d52; }
.act-status.started { background: linear-gradient(135deg,#fff6e8 0%,#ffecc4 100%); color: #c98517; }

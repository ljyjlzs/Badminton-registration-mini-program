<view class="album-page">
  <view wx:if="{{loading}}" class="album-loading">
    <view class="loading-spinner"></view>
    <text style="color:#8d9a95">加载中...</text>
  </view>

  <block wx:else>
    <!-- 相册标题/说明 -->
    <view class="album-header" style="padding: 24rpx; background: #fff; margin-bottom: 16rpx;">
      <view style="display: flex; justify-content: space-between; align-items: center;">
        <text style="font-size: 32rpx; font-weight: 700; color: #1f2d29;">{{albumTitle || '活动相册'}}</text>
        <view wx:if="{{isOrganizer}}" style="font-size: 24rpx; color: #0ea56b;" bindtap="editAlbumInfo">编辑</view>
      </view>
      <text wx:if="{{albumNote}}" style="font-size: 26rpx; color: #84938e; margin-top: 8rpx; display: block;">{{albumNote}}</text>
    </view>

    <!-- BUG-17: AI 相册小记入口（跳转 ai-note-preview） -->
    <navigator url="/pages/ai-note-preview/ai-note-preview?activityId={{activityId}}" hover-class="none" style="display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 20rpx 24rpx; margin-bottom: 16rpx;">
      <text style="font-size: 28rpx; color: #1f2d29;">🤖 AI 相册小记</text>
      <text style="color: #999; font-size: 32rpx;">›</text>
    </navigator>

    <!-- Tab 切换 -->
    <view class="tab-bar" style="display: flex; background: #fff; margin-bottom: 16rpx;">
      <view class="tab-item {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all" style="flex: 1; text-align: center; padding: 20rpx; font-size: 28rpx; color: {{currentTab === 'all' ? '#0ea56b' : '#666'}}; border-bottom: 4rpx solid {{currentTab === 'all' ? '#0ea56b' : 'transparent'}};">全部 ({{allPhotos.length || total}})</view>
      <view class="tab-item {{currentTab === 'featured' ? 'active' : ''}}" bindtap="switchTab" data-tab="featured" style="flex: 1; text-align: center; padding: 20rpx; font-size: 28rpx; color: {{currentTab === 'featured' ? '#0ea56b' : '#666'}}; border-bottom: 4rpx solid {{currentTab === 'featured' ? '#0ea56b' : 'transparent'}};">精选 ({{featured.length}})</view>
    </view>

    <!-- 照片网格 -->
    <view class="photo-grid" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8rpx; padding: 0 16rpx;">
      <view wx:for="{{currentTab === 'all' ? photos : featured}}" wx:key="_id" class="photo-item" style="position: relative; border-radius: 8rpx; overflow: hidden;"
        data-id="{{item._id}}" bindtap="goDetail" bindlongpress="onPhotoLongPress" data-item="{{item}}">
        <image src="{{item.thumbFileID || item.fileID}}" mode="aspectFill" lazy-load binderror="onImgError" style="width: 100%; height: 240rpx; display: block;" />
        <view style="position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.4); padding: 8rpx 12rpx; display: flex; justify-content: space-between;">
          <text style="font-size: 20rpx; color: #fff;">♥ {{item.likeCount || 0}}</text>
          <text style="font-size: 20rpx; color: #fff;">💬 {{item.commentCount || 0}}</text>
        </view>
        <view wx:if="{{item.featured}}" style="position: absolute; top: 8rpx; right: 8rpx; background: #f6a53b; color: #fff; font-size: 18rpx; padding: 2rpx 8rpx; border-radius: 4rpx;">精选</view>
      </view>
    </view>

    <!-- PERF-13: 缓冲区还有照片时显示"加载更多" -->
    <view wx:if="{{currentTab === 'all' && renderLimit < allPhotos.length}}" style="text-align: center; padding: 16rpx;">
      <button bindtap="showMorePhotos" style="background: #f0f7ff; color: #0ea56b; font-size: 26rpx; padding: 12rpx 40rpx; border-radius: 24rpx; border: none;">加载更多 ({{allPhotos.length - renderLimit}})</button>
    </view>

    <view wx:if="{{currentTab === 'all' ? photos.length === 0 : featured.length === 0}}" style="text-align: center; padding: 80rpx 40rpx;">
      <text style="font-size: 60rpx; display: block;">📷</text>
      <text style="font-size: 28rpx; color: #84938e; margin-top: 16rpx;">暂无照片</text>
    </view>

    <!-- AI 小记 -->
    <view wx:if="{{aiNote}}" style="margin: 24rpx 16rpx; background: linear-gradient(135deg, #f0f7ff, #e8f4fd); border-radius: 16rpx; padding: 24rpx;">
      <view style="display: flex; align-items: center; gap: 8rpx; margin-bottom: 12rpx;">
        <text style="font-size: 28rpx;">🤖</text>
        <text style="font-size: 26rpx; font-weight: 600; color: #4f69f1;">AI 小记</text>
      </view>
      <text style="font-size: 26rpx; color: #333; line-height: 1.6;">{{aiNote}}</text>
    </view>

    <!-- 底部操作栏 -->
    <view class="btn-bar" style="display: flex; gap: 12rpx; padding: 24rpx;">
      <button wx:if="{{isMember}}" class="btn-primary" style="flex: 1;" bindtap="uploadPhoto">上传照片</button>
      <button class="btn-secondary" style="flex: 1;" bindtap="generatePoster">分享海报</button>
      <button wx:if="{{isOrganizer}}" class="btn-secondary" style="flex: 1;" bindtap="goAiFeature">AI 精选</button>
      <button wx:if="{{isOrganizer}}" class="btn-secondary" style="flex: 1;" disabled="{{aiNoting}}" bindtap="generateAiNote">AI 小记</button>
    </view>
  </block>

  <!-- 评论弹窗 -->
  <view wx:if="{{showComments}}" class="picker-mask" bindtap="closeComments">
    <view class="picker-content" catchtap="stopPropagation" style="max-height: 70vh;">
      <view class="picker-title">评论</view>
      <view style="max-height: 50vh; overflow-y: auto;">
        <view wx:for="{{comments}}" wx:key="_id" style="padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; display: flex; justify-content: space-between; align-items: center;">
          <view>
            <text style="font-size: 26rpx; font-weight: 600; color: #333;">{{item.nickname || '匿名'}}</text>
            <text style="font-size: 26rpx; color: #666; margin-left: 12rpx;">{{item.content}}</text>
          </view>
          <view wx:if="{{isOrganizer || item.userId === openid}}" style="font-size: 22rpx; color: #c62828;" bindtap="deleteComment" data-id="{{item._id}}">删除</view>
        </view>
        <view wx:if="{{comments.length === 0}}" style="text-align: center; padding: 40rpx; color: #999;">暂无评论</view>
      </view>
      <view style="display: flex; gap: 12rpx; margin-top: 20rpx;">
        <input class="form-input" placeholder="写评论..." value="{{commentText}}" bindinput="onCommentInput" style="flex: 1;" />
        <button class="btn-confirm" bindtap="submitComment" disabled="{{!commentText.trim()}}">发送</button>
      </view>
    </view>
  </view>

  <!-- 编辑相册信息弹窗 -->
  <view wx:if="{{showEditAlbum}}" class="picker-mask" bindtap="closeEditAlbum">
    <view class="picker-content" catchtap="stopPropagation">
      <view class="picker-title">编辑相册信息</view>
      <view class="form-item">
        <view class="form-label">相册标题</view>
        <input class="form-input" placeholder="输入标题" value="{{editTitle}}" bindinput="onEditTitleInput" />
      </view>
      <view class="form-item">
        <view class="form-label">相册说明</view>
        <input class="form-input" placeholder="输入说明" value="{{editNote}}" bindinput="onEditNoteInput" />
      </view>
      <view class="picker-actions">
        <button class="btn-cancel" bindtap="closeEditAlbum">取消</button>
        <button class="btn-confirm" bindtap="saveAlbumInfo">保存</button>
      </view>
    </view>
  </view>

  <!-- 长按菜单 -->
  <view wx:if="{{showContextMenu}}" class="picker-mask" bindtap="closeContextMenu">
    <view class="picker-content" catchtap="stopPropagation" style="padding: 0;">
      <view style="padding: 24rpx; text-align: center; border-bottom: 1rpx solid #f0f0f0;" bindtap="contextDeletePhoto">删除照片</view>
      <view style="padding: 24rpx; text-align: center; border-bottom: 1rpx solid #f0f0f0;" bindtap="toggleLike">{{contextLiked ? '取消点赞' : '点赞'}} ({{contextLikeCount || 0}})</view>
      <view style="padding: 24rpx; text-align: center; border-bottom: 1rpx solid #f0f0f0;" bindtap="openComments">评论</view>
      <view style="padding: 24rpx; text-align: center; border-bottom: 1rpx solid #f0f0f0;" bindtap="contextToggleFeatured">{{contextFeatured ? '取消精选' : '设为精选'}}</view>
      <view style="padding: 24rpx; text-align: center; color: #999;" bindtap="closeContextMenu">取消</view>
    </view>
  </view>

  <!-- Canvas for poster -->
  <canvas canvas-id="posterCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 750px; height: 1334px;"></canvas>
</view>

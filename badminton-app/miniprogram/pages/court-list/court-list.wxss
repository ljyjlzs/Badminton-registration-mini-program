.court-page { padding: 24rpx; min-height: 100vh; }
.court-loading { min-height: 100vh; display: flex; align-items: center; justify-content: center; }
.overview-card { background: linear-gradient(145deg, #f9fffc 0%, #eef7f3 100%); border-radius: 34rpx; padding: 32rpx 28rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 24rpx rgba(14,165,107,0.08); border: 1rpx solid rgba(14,165,107,0.12); }
.overview-kicker { font-size: 20rpx; letter-spacing: 5rpx; color: #0a7d52; margin-bottom: 12rpx; }
.activity-name { font-size: 40rpx; line-height: 1.25; color: #12332b; font-weight: 800; }
.overview-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 18rpx; margin-top: 20rpx; }
.overview-item { padding: 22rpx 20rpx; border-radius: 24rpx; background: rgba(255,255,255,0.85); border: 1rpx solid rgba(18,69,51,0.05); }
.overview-label { display: block; font-size: 22rpx; color: #8d9a95; margin-bottom: 8rpx; }
.overview-value { display: block; font-size: 27rpx; line-height: 1.5; color: #12332b; font-weight: 600; }
.detail-section { background: rgba(255,255,255,0.96); padding: 30rpx 26rpx; border-radius: 30rpx; margin-bottom: 24rpx; border: 1rpx solid rgba(18,69,51,0.06); box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04); }
.section-title { display: block; font-size: 32rpx; line-height: 1.3; color: #12332b; font-weight: 700; margin-bottom: 20rpx; }
.court-card { padding: 24rpx; border-radius: 24rpx; background: linear-gradient(135deg,#f7fbf9 0%,#f1f7f4 100%); border: 1rpx solid rgba(18,69,51,0.05); margin-bottom: 16rpx; }
.court-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.court-label { font-size: 30rpx; font-weight: 700; color: #12332b; }
.court-capacity { font-size: 24rpx; color: #8d9a95; }
.court-members { display: flex; flex-wrap: wrap; gap: 14rpx; }
.court-member { display: flex; align-items: center; gap: 10rpx; padding: 12rpx 18rpx; border-radius: 999rpx; background: rgba(244,247,246,0.96); }
.court-member .avatar { width: 48rpx; height: 48rpx; border-radius: 50%; font-size: 22rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg,#0ea56b,#0bc278); }
.court-member .name { font-size: 24rpx; color: #12332b; }
.btn-remove { font-size: 22rpx; color: #d64545; padding: 8rpx 16rpx; border-radius: 999rpx; background: rgba(255,245,245,0.98); border: 1rpx solid rgba(214,69,69,0.16); }
.unassigned-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.empty-tip { padding: 32rpx; text-align: center; font-size: 26rpx; color: #8d9a95; }
.action-bar { display: flex; gap: 16rpx; flex-wrap: wrap; margin-top: 16rpx; }
.btn-auto, .btn-add, .btn-start-court { flex: 1; min-width: 200rpx; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 999rpx; font-size: 28rpx; font-weight: 700; border: none; }
.btn-auto { background: linear-gradient(135deg,#536ff3 0%,#6b53c5 100%); color: #fff; }
.btn-add { background: rgba(244,247,246,0.96); color: #12332b; border: 2rpx solid rgba(18,69,51,0.12); }
.btn-start-court { background: linear-gradient(135deg,#f6a53b 0%,#ee8f1d 100%); color: #fff; }
.btn-config { margin-top: 16rpx; width: 100%; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 999rpx; font-size: 28rpx; font-weight: 700; background: rgba(244,247,246,0.96); color: #12332b; border: 2rpx solid rgba(18,69,51,0.12); }
.modal-mask { position: fixed; inset: 0; background: rgba(12,33,26,0.42); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(10rpx); }
.modal-content { width: 580rpx; background: #fff; border-radius: 28rpx; padding: 48rpx 40rpx 36rpx; box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.12); text-align: center; }
.modal-title { font-size: 34rpx; font-weight: 700; color: #12332b; margin-bottom: 32rpx; }
.modal-input { width: 100%; height: 88rpx; border: 2rpx solid rgba(18,69,51,0.12); border-radius: 16rpx; padding: 0 24rpx; font-size: 30rpx; text-align: center; }
.modal-btns { display: flex; gap: 20rpx; margin-top: 32rpx; }
.modal-btns .btn-cancel, .modal-btns .btn-confirm { flex: 1; height: 84rpx; line-height: 84rpx; border-radius: 999rpx; font-size: 30rpx; font-weight: 700; border: none; }
.modal-btns .btn-cancel { background: #f0f5f3; color: #4a5e56; }
.modal-btns .btn-confirm { background: linear-gradient(135deg,#0ea56b,#0bc278); color: #fff; }
.ready-ok { padding: 16rpx 24rpx; border-radius: 16rpx; background: linear-gradient(135deg,#ebfaf2 0%,#def3e8 100%); color: #0a7d52; font-size: 26rpx; text-align: center; margin-top: 16rpx; }
.ready-warn { padding: 16rpx 24rpx; border-radius: 16rpx; background: linear-gradient(135deg,#fff6e8 0%,#ffecc4 100%); color: #c98517; font-size: 24rpx; line-height: 1.6; margin-top: 16rpx; }

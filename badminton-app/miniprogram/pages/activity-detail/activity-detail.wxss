.detail-page {
  min-height: 100vh;
}

.detail-loading {
  min-height: 100vh;
}

.detail-shell {
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.overview-card {
  background: linear-gradient(145deg, #f9fffc 0%, #eef7f3 100%);
  border-radius: 34rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(14, 165, 107, 0.12);
}

.overview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.overview-head-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.btn-share {
  font-size: 22rpx;
  line-height: 1.6;
  padding: 4rpx 18rpx;
  margin: 0;
  border-radius: 999rpx;
  background: #f0f7f4;
  color: #0ea56b;
  border: 1rpx solid rgba(14, 165, 107, 0.2);
}

.btn-share::after {
  border: none;
}

.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.bottom-action-bar .btn-primary,
.bottom-action-bar .btn-cancel-reg,
.bottom-action-bar .btn-waitlist {
  width: 100%;
  margin-top: 0;
}

.overview-copy {
  flex: 1;
  min-width: 0;
}

.overview-kicker {
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: var(--primary-dark);
  margin-bottom: 12rpx;
}

.activity-name {
  font-size: 40rpx;
  line-height: 1.25;
  color: var(--text-primary);
  font-weight: 800;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.overview-item {
  padding: 22rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(18, 69, 51, 0.05);
}

.overview-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
}

.overview-value {
  display: block;
  font-size: 27rpx;
  line-height: 1.5;
  color: var(--text-primary);
  font-weight: 600;
}

.progress-block {
  padding-top: 6rpx;
}

.progress-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.progress-title {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.progress-value {
  font-size: 24rpx;
  color: var(--primary-dark);
  font-weight: 700;
}

.organizer-tip {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #fff7e9 0%, #ffecc2 100%);
  color: #c98517;
  font-size: 24rpx;
  line-height: 1.6;
}

.detail-section {
  background: rgba(255, 255, 255, 0.96);
  padding: 30rpx 26rpx;
  border-radius: 30rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(18, 69, 51, 0.06);
  box-shadow: var(--shadow-card);
}

.section {
  background: rgba(255, 255, 255, 0.96);
}

.section-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.3;
  color: var(--text-primary);
  font-weight: 700;
}

.section-header {
  align-items: flex-start;
  gap: 18rpx;
}

.section-caption {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

.section-count {
  font-size: 24rpx;
  color: var(--text-secondary);
  background: rgba(244, 247, 246, 0.95);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
}

.section-tags {
  display: flex;
  gap: 10rpx;
}

.registration-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.registration-item {
  width: 152rpx;
  padding: 20rpx 16rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f7fbf9 0%, #f1f7f4 100%);
  border: 1rpx solid rgba(18, 69, 51, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.registration-item-wrap {
  position: relative;
}

.registration-item-wrap:active .registration-item {
  transform: scale(0.985);
}

.registration-item .avatar-text {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  background: var(--primary-gradient);
}

.reg-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.registration-item .nickname {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 600;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.partner-tag {
  font-size: 20rpx;
  color: var(--primary-color);
  margin-top: 4rpx;
}

.compact-empty {
  padding: 48rpx 20rpx;
}

.compact-inline-empty {
  width: 100%;
  padding: 12rpx 0 0;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.joined-tip,
.full-tip,
.cancel-pending-tip,
.pending-cancel-tip,
.start-hint,
.wait-hint {
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
  line-height: 1.6;
  text-align: center;
}

.joined-tip {
  background: linear-gradient(135deg, #ebfaf2 0%, #def3e8 100%);
  color: var(--primary-dark);
}

.full-tip {
  background: rgba(244, 247, 246, 0.96);
  color: var(--text-tertiary);
}

.cancel-pending-tip,
.pending-cancel-tip,
.wait-hint {
  background: linear-gradient(135deg, #fff6e8 0%, #ffecc4 100%);
  color: #cc8615;
}

.start-hint {
  background: linear-gradient(135deg, #ebfaf2 0%, #def3e8 100%);
  color: var(--primary-dark);
}

.organizer-action {
  margin-top: 8rpx;
}

.organizer-btns {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.organizer-btns .btn-start,
.organizer-btns .btn-delete,
.organizer-btns .btn-finish {
  flex: 1;
  min-width: 220rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 700;
  border: none;
}

.btn-start {
  background: linear-gradient(135deg, #f6a53b 0%, #ee8f1d 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(238, 143, 29, 0.22);
}

.btn-finish {
  background: linear-gradient(135deg, #536ff3 0%, #6b53c5 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(83, 111, 243, 0.2);
}

.btn-delete {
  background: rgba(255, 245, 245, 0.98);
  color: #d64545;
  border: 2rpx solid rgba(214, 69, 69, 0.16);
}

.btn-center {
  display: flex;
  justify-content: center;
}

.btn-center .btn-start,
.btn-center .btn-challenge,
.btn-center .btn-final {
  width: auto;
  min-width: 320rpx;
  padding: 0 56rpx;
}

.btn-challenge,
.btn-final,
.btn-ranking {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  text-align: center;
  border: none;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-challenge {
  background: linear-gradient(135deg, #eb4f8f 0%, #da3a76 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(218, 58, 118, 0.22);
}

.btn-final {
  background: linear-gradient(135deg, #ffad3b 0%, #f28b1e 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(242, 139, 30, 0.22);
}

.section-tag {
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}

.challenge-tag {
  background: rgba(218, 58, 118, 0.12);
  color: #cf2f6d;
}

.final-tag {
  background: rgba(242, 139, 30, 0.14);
  color: #d57910;
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.match-card {
  padding: 30rpx 26rpx;
}

.challenge-match {
  background: linear-gradient(145deg, #a6256a 0%, #d6478b 100%) !important;
}

.final-match {
  background: linear-gradient(145deg, #d47f16 0%, #f4a933 100%) !important;
}

.match-pending {
  border: 2rpx dashed rgba(255, 255, 255, 0.42) !important;
}

.match-playing,
.challenge-match.match-playing,
.final-match.match-playing {
  animation: pulse 1.5s ease-in-out infinite !important;
}

.match-confirming,
.challenge-match.match-confirming,
.final-match.match-confirming {
  animation: blink 1.1s ease-in-out infinite !important;
}

.playing-status {
  background: rgba(255, 255, 255, 0.2) !important;
  color: #ffffff !important;
}

.confirm-status {
  background: rgba(255, 255, 255, 0.16) !important;
  color: #ffffff !important;
}

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 14rpx 30rpx rgba(56, 239, 125, 0.3);
  }
  50% {
    box-shadow: 0 16rpx 40rpx rgba(56, 239, 125, 0.46);
  }
}

@keyframes blink {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.01);
  }
}

.btn-ranking {
  width: 100%;
  background: linear-gradient(135deg, #4f69f1 0%, #6149b8 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(97, 73, 184, 0.2);
}

.picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(12, 33, 26, 0.42);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
  backdrop-filter: blur(10rpx);
}

.picker-content {
  width: 100%;
  padding: 40rpx 24rpx calc(36rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-radius: 36rpx 36rpx 0 0;
}

.picker-title {
  font-size: 34rpx;
  color: var(--text-primary);
  font-weight: 700;
  text-align: center;
  margin-bottom: 32rpx;
}

.selected-level-tip {
  text-align: center;
  color: var(--text-secondary);
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.level-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.level-item {
  flex: 1 1 calc(33.333% - 14rpx);
  min-width: 160rpx;
  padding: 16rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(244, 247, 246, 0.96);
  border: 2rpx solid rgba(18, 69, 51, 0.06);
  color: var(--text-secondary);
  text-align: center;
  font-size: 26rpx;
}

.level-item.selected {
  background: var(--primary-gradient);
  color: #ffffff;
  border-color: transparent;
  box-shadow: var(--shadow-primary);
}

.avatar-form-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.avatar-change-hint {
  font-size: 22rpx;
  color: var(--primary-color);
  margin-top: 10rpx;
}

.avatar-upload-btn2 {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(244, 247, 246, 0.96);
  border: 2rpx dashed rgba(18, 69, 51, 0.12);
  padding: 0;
  margin: 0;
}

.avatar-upload-btn2::after {
  border: none;
}

.avatar-placeholder-btn {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-tertiary);
}

.upload-icon {
  font-size: 48rpx;
}

.upload-text {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.partner-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.partner-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(244, 247, 246, 0.96);
  border: 2rpx solid transparent;
}

.partner-item.selected {
  border-color: rgba(14, 165, 107, 0.22);
  background: rgba(231, 247, 239, 0.96);
}

.partner-avatar {
  width: 48rpx;
  height: 48rpx;
  min-width: 48rpx;
  border-radius: 50%;
  font-size: 22rpx;
  margin-bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: var(--primary-gradient);
}

.partner-name {
  font-size: 24rpx;
  color: var(--text-primary);
}

.partner-level {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.picker-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-cancel {
  background: rgba(244, 247, 246, 0.96);
  color: var(--text-secondary);
}

.btn-confirm {
  background: var(--primary-gradient);
  color: #ffffff;
  box-shadow: var(--shadow-primary);
}

.btn-cancel-reg {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: rgba(255, 245, 245, 0.98);
  color: #d64545;
  border: 2rpx solid rgba(214, 69, 69, 0.16);
  font-size: 30rpx;
  font-weight: 700;
}

.cancel-request-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 18rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  margin-top: 10rpx;
  background: rgba(255, 243, 224, 0.96);
  color: #c98517;
  font-weight: 700;
}

.cancel-request-tag::before {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #d58c1b;
}

/* UX-17: 解绑搭档热区（约 44px，iOS HIG） */
.unbind-partner-hotzone {
  padding: 8rpx 16rpx;
  font-size: 26rpx;
  min-height: 64rpx;
}

.registration-item-wrap.has-pending .registration-item {
  background: linear-gradient(135deg, #fffaf1 0%, #fff3df 100%);
  border-color: rgba(213, 140, 27, 0.16);
  box-shadow: 0 10rpx 20rpx rgba(213, 140, 27, 0.08);
}

.registration-item-wrap.has-pending .registration-item::after {
  content: '待处理';
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(213, 140, 27, 0.12);
  color: #c98517;
  font-size: 18rpx;
  font-weight: 700;
}

.registration-item {
  position: relative;
}

/* 取消报名审批弹窗 */
.cancel-modal-content {
  width: 580rpx;
  background: var(--surface-card, #ffffff);
  border-radius: var(--radius-xl, 28rpx);
  padding: 48rpx 40rpx 36rpx;
  box-shadow: var(--shadow-lg, 0 12rpx 40rpx rgba(0,0,0,0.12));
  text-align: center;
}

.cancel-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary, #12332b);
  margin-bottom: 32rpx;
}

.cancel-modal-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.cancel-modal-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  background: var(--primary-gradient, linear-gradient(135deg, #0ea56b, #0bc278));
}

.cancel-modal-detail {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.cancel-modal-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary, #12332b);
}

.cancel-modal-level {
  font-size: 24rpx;
  color: var(--text-tertiary, #8d9a95);
  margin-top: 4rpx;
}

.cancel-modal-tip {
  font-size: 26rpx;
  color: var(--text-secondary, #4a5e56);
  margin-bottom: 36rpx;
  line-height: 1.6;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(244, 247, 246, 0.96);
}

.cancel-modal-btns {
  display: flex;
  gap: 20rpx;
}

.cancel-modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: var(--radius-full, 999rpx);
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  padding: 0;
  min-height: 84rpx;
  box-sizing: border-box;
}

.cancel-modal-btn.reject {
  background: var(--bg-gray, #f0f5f3);
  color: var(--text-secondary, #4a5e56);
  border: 1rpx solid var(--border-light, rgba(18,69,51,0.08));
}

.cancel-modal-btn.reject:active {
  transform: scale(0.985);
}

.cancel-modal-btn.approve {
  background: var(--primary-gradient, linear-gradient(135deg, #0ea56b, #0bc278));
  color: var(--text-inverse, #ffffff);
  box-shadow: var(--shadow-primary, 0 6rpx 16rpx rgba(14,165,107,0.28));
}

.cancel-modal-btn.approve:active {
  transform: scale(0.985);
}

/* ===== T5 容量调整 ===== */
.capacity-entry {
  display: inline-flex;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(14,165,107,0.08);
  color: #0ea56b;
  font-size: 24rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

/* ===== T7 候补 ===== */
.btn-waitlist {
  margin-top: 20rpx;
  background: #f0f7f4;
  color: #0ea56b;
  border: 2rpx solid rgba(14,165,107,0.2);
}
.btn-waitlist:active { background: #e6f3ed; }
.waitlist-section { margin-top: 16rpx; }
.waitlist-section .section-caption { font-size: 28rpx; font-weight: 600; color: #333; display: flex; align-items: center; }

/* ===== T9 AI 栏 ===== */
.ai-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}
.ai-grid-item {
  background: #f9fffc;
  border: 1rpx solid rgba(14,165,107,0.12);
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.ai-grid-item:active { background: #eef7f3; }
.ai-grid-icon { font-size: 40rpx; }
.ai-grid-label { font-size: 24rpx; color: #1f2d29; font-weight: 600; }

/* ===== 代报名弹窗 ===== */
.agent-entry {
  margin-top: 24rpx;
}
.btn-agent {
  background: #f9fffc;
  color: #0ea56b;
  border: 2rpx solid rgba(14,165,107,0.2);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 20rpx 0;
}
.btn-agent:active { background: #eef7f3; }

/* ===== 近期活动列表 ===== */
.recent-list {
  margin-top: 16rpx;
}
.recent-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.recent-item:last-child { border-bottom: none; }
.recent-name { font-size: 28rpx; font-weight: 600; color: #1f2d29; display: block; }
.recent-meta { font-size: 22rpx; color: #84938e; display: block; margin-top: 4rpx; }

/* ===== 活动快照 ===== */
.snapshot-title { font-size: 28rpx; font-weight: 600; color: #1f2d29; margin-bottom: 12rpx; }
.snapshot-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.snapshot-item { background: #f9fffc; border-radius: 12rpx; padding: 16rpx; text-align: center; }
.snapshot-val { font-size: 32rpx; font-weight: 700; color: #0ea56b; display: block; }
.snapshot-label { font-size: 22rpx; color: #84938e; display: block; margin-top: 4rpx; }

/* ===== 禁止开始提示 ===== */
.no-start-tip { background: #fff6f6; color: #c0392b; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 26rpx; margin-top: 12rpx; }

/* ===== 排名截断 ===== */
.rank-truncate { max-height: 480rpx; overflow: hidden; position: relative; }
.rank-truncate.rank-expanded { max-height: none; }
.rank-toggle { text-align: center; padding: 16rpx 0; color: #0ea56b; font-size: 26rpx; font-weight: 600; }

/* ===== 新比赛 UI ===== */
.btns-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.btns-row button { flex: 1; }

/* ===== 组织者解析区 ===== */
.org-reason { background: #f9fffc; border-radius: 16rpx; padding: 20rpx; margin-top: 16rpx; }
.org-reason-text { font-size: 26rpx; color: #1f2d29; line-height: 1.6; }

/* ===== 满员提示 ===== */
.full-tip-inline { display: inline-flex; background: #fff6f6; color: #c0392b; border-radius: 999rpx; padding: 8rpx 20rpx; font-size: 24rpx; margin-top: 12rpx; }

/* ===== T22 全局 banner ===== */
.global-banner { background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx; }
.global-banner-row { display: flex; align-items: center; gap: 12rpx; padding: 8rpx 0; }
.global-banner-row.live { color: #0ea56b; font-weight: 600; }
.banner-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #ccc; }
.global-banner-row.live .banner-dot { background: #0ea56b; }
.banner-text { font-size: 26rpx; color: #333; }

/* ===== T26 比赛卡片增强 ===== */
.match-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.card-copy { flex: 1; }
.round-label { font-size: 24rpx; color: #84938e; font-weight: 600; }
.match-card-body { display: flex; align-items: center; gap: 16rpx; }
.team-block { flex: 1; text-align: center; }
.team-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; margin: 0 auto 8rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 700; color: #fff; }
.team1-avatar { background: linear-gradient(135deg, #0ea56b, #0bc278); }
.team2-avatar { background: linear-gradient(135deg, #536ff3, #6b53c5); }
.team-name-row { display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.team-name { font-size: 28rpx; font-weight: 700; color: #1f2d29; }
.win-tag { font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 999rpx; background: #0ea56b; color: #fff; }
.team-members { font-size: 22rpx; color: #84938e; display: block; }
.vs-block { flex-shrink: 0; }
.vs-circle { width: 64rpx; height: 64rpx; border-radius: 50%; background: #f0f5f3; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 700; color: #84938e; }
.match-card-actions { margin-top: 16rpx; text-align: center; }
.score-band { display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.score-num { font-size: 36rpx; font-weight: 800; color: #1f2d29; }
.score-num.winner { color: #0ea56b; }
.score-colon { font-size: 28rpx; color: #ccc; }
.status-line { font-size: 24rpx; color: #84938e; }
.status-line.playing { color: #0ea56b; font-weight: 600; }

/* UX-11: 我的比赛高亮 */
.match-card.my-match {
  border: 2rpx solid rgba(14, 165, 107, 0.45);
  background: linear-gradient(180deg, #f3fbf7 0%, #ffffff 100%);
  box-shadow: 0 8rpx 24rpx rgba(14, 165, 107, 0.12);
}
.my-tag {
  margin-left: 8rpx;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #0ea56b;
  color: #fff;
  font-weight: 700;
}

/* UX-22: 时间格可点加入日历 */
.time-cell {
  position: relative;
}
.time-cell .calendar-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--primary-color, #0ea56b);
  opacity: 0.8;
}

/* UX-17: 代报操作热区 */
.agent-op {
  min-height: 56rpx;
  padding: 12rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== T8 代报列表 ===== */
.agent-reg-list { margin-top: 16rpx; }
.agent-reg-item { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f0f5f3; }
.agent-reg-item:last-child { border-bottom: none; }
.agent-reg-info { flex: 1; }

/* ===== T24 头像图片 ===== */
.avatar-img { width: 88rpx; height: 88rpx; border-radius: 50%; margin-bottom: 14rpx; }

/* ===== T48 语音填分 ===== */
.voice-section { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; text-align: center; }
.voice-section.voice-disabled { opacity: 0.6; }
.voice-main { display: inline-flex; align-items: center; gap: 12rpx; padding: 20rpx 40rpx; border-radius: 999rpx; background: linear-gradient(135deg, #f0f7ff 0%, #e8f4fd 100%); border: 1rpx solid rgba(79,105,241,0.16); }
.voice-main.recording { background: linear-gradient(135deg, #fff0f0 0%, #ffe8e8 100%); border-color: rgba(214,69,69,0.2); }
.voice-mic { font-size: 36rpx; }
.voice-label { font-size: 28rpx; font-weight: 600; color: #4f69f1; }
.voice-main.recording .voice-label { color: #d64545; }
.voice-hint { font-size: 24rpx; color: #84938e; margin-top: 12rpx; display: block; }
.voice-confirm-bar { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08); }
.voice-confirm-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.voice-confirm-title { font-size: 28rpx; font-weight: 700; color: #1f2d29; }
.voice-confirm-score { font-size: 32rpx; font-weight: 800; color: #0ea56b; }
.voice-confirm-btns { display: flex; gap: 16rpx; }
.voice-btn-cancel { flex: 1; height: 80rpx; line-height: 80rpx; border-radius: 999rpx; background: #f4f7f6; color: #4a5e56; font-size: 28rpx; font-weight: 600; border: none; }
.voice-btn-confirm { flex: 1; height: 80rpx; line-height: 80rpx; border-radius: 999rpx; background: #0ea56b; color: #fff; font-size: 28rpx; font-weight: 600; border: none; }
.voice-btn-confirm[disabled] { background: #cdd7d2; }

/* ===== T11 导航按钮 ===== */
.nav-buttons { display: flex; gap: 16rpx; margin-top: 24rpx; }
.nav-btn { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 24rpx 0; background: #f9fffc; border-radius: 16rpx; }
.nav-btn-icon { font-size: 36rpx; }
.nav-btn-text { font-size: 24rpx; color: #1f2d29; font-weight: 600; }

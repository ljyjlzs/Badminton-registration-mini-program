.page-shell { padding: 24rpx; padding-bottom: 140rpx; min-height: 100vh; background: #f5f8f7; }

/* AI-38: 兜底横幅（浅黄提示条） */
.fallback-banner {
  background: #fff7e6;
  color: #b8860b;
  border: 1rpx solid #ffe7a8;
  font-size: 22rpx;
  line-height: 1.5;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  max-width: 80%;
}

/* AI-38: 失败/错误气泡（可点击重试） */
.error-bubble {
  background: #fdecec;
  color: #c0392b;
  padding: 16rpx 24rpx;
  border-radius: 20rpx 20rpx 20rpx 4rpx;
  max-width: 80%;
  font-size: 28rpx;
  line-height: 1.5;
  white-space: pre-wrap;
}

.error-retry-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #e74c3c;
  text-decoration: underline;
}

.feature-page { padding: 24rpx; }
.tpl-tag { display: inline-block; font-size: 24rpx; color: #0ea56b; background: #e6f7f0; border-radius: 8rpx; padding: 6rpx 16rpx; margin-bottom: 16rpx; }
.loading { text-align: center; color: #999; padding: 48rpx 0; }
.empty { text-align: center; padding: 80rpx 0; }
.sug-item { display: flex; align-items: center; background: #fff; border-radius: 12rpx; padding: 16rpx; margin-bottom: 16rpx; }
.sug-img { width: 120rpx; height: 120rpx; border-radius: 8rpx; }
.sug-info { flex: 1; margin: 0 16rpx; }
.sug-reason { font-size: 26rpx; color: #666; }
.box { width: 40rpx; height: 40rpx; border: 2rpx solid #ccc; border-radius: 8rpx; box-sizing: border-box; }
.box.checked { background: #0ea56b; border-color: #0ea56b; }
.btn-gen, .btn-apply { height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 44rpx; margin-top: 24rpx; color: #fff; }
.btn-gen { background: #1989fa; }
.btn-apply { background: #0ea56b; }

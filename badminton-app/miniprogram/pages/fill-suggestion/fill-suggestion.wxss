.fill-page { background: #f3f5f7; }
.fill-shell { padding: 24rpx; }
.summary-card { background: #fff; border-radius: 24rpx; padding: 30rpx 28rpx; margin-bottom: 24rpx; box-shadow: 0 6rpx 18rpx rgba(26,40,35,0.07); }
.summary-head { padding-bottom: 22rpx; border-bottom: 2rpx solid rgba(27,43,38,0.06); margin-bottom: 24rpx; }
.summary-title { font-size: 34rpx; font-weight: 800; color: #202b27; }
.summary-tag { font-size: 22rpx; color: #84938e; display: block; margin-top: 8rpx; }
.summary-numbers { display: flex; gap: 16rpx; margin-bottom: 22rpx; }
.num-item { flex: 1; padding: 22rpx 18rpx; border-radius: 16rpx; background: #f4f8f6; text-align: center; }
.num-value { font-size: 40rpx; font-weight: 800; color: #202b27; }
.num-unit { font-size: 24rpx; font-weight: 600; color: #84938e; }
.num-label { display: block; margin-top: 10rpx; font-size: 22rpx; color: #84938e; }
.gap-rows { display: flex; flex-direction: column; gap: 12rpx; }
.gap-row { padding: 18rpx 22rpx; border-radius: 16rpx; background: #e6f5ef; color: #0b7a54; font-size: 26rpx; font-weight: 600; text-align: center; }
.section-card { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 6rpx 18rpx rgba(26,40,35,0.07); }
.section-head { margin-bottom: 22rpx; }
.section-title { font-size: 30rpx; font-weight: 700; color: #202b27; }
.rec-item { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.rec-item:last-child { border-bottom: none; }
.rec-text { flex: 1; font-size: 26rpx; color: #333; margin-right: 16rpx; }
.copy-btn { flex-shrink: 0; height: 56rpx; min-width: 100rpx; padding: 0 20rpx; border-radius: 12rpx; background: #e6f5ef; color: #0d9f6d; border: 1rpx solid rgba(13,159,109,0.16); font-size: 24rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }

.invite-page { min-height: 100vh; padding: 24rpx 24rpx 48rpx; box-sizing: border-box; }
.invite-hero { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 30rpx 28rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); margin-bottom: 24rpx; }
.hero-copy { flex: 1; }
.hero-badge { display: inline-flex; padding: 8rpx 16rpx; border-radius: 999rpx; background: #e6f7f0; color: #0ea56b; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; margin-bottom: 14rpx; }
.hero-title { font-size: 38rpx; font-weight: 800; color: #1f2d29; }
.hero-desc { font-size: 24rpx; color: #84938e; margin-top: 8rpx; }
.hero-count { min-width: 130rpx; padding: 18rpx 16rpx; border-radius: 20rpx; background: #f4f8f6; text-align: center; }
.count-num { font-size: 40rpx; font-weight: 800; color: #0ea56b; display: block; }
.count-label { font-size: 20rpx; color: #84938e; display: block; margin-top: 8rpx; }
.invite-loading { min-height: 60vh; }
.candidate-list { display: flex; flex-direction: column; gap: 16rpx; }
.candidate-card { display: flex; align-items: center; gap: 18rpx; padding: 22rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); border: 2rpx solid transparent; }
.candidate-card.selected { border-color: rgba(13,159,109,0.35); background: linear-gradient(135deg, #f4fbf8, #edf7f2); }
.candidate-avatar { width: 84rpx; height: 84rpx; min-width: 84rpx; border-radius: 50%; background: linear-gradient(135deg, #0ea56b, #0b8f61); color: #fff; font-size: 34rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.candidate-copy { flex: 1; min-width: 0; }
.candidate-name-row { display: flex; align-items: center; gap: 12rpx; }
.candidate-name { font-size: 30rpx; font-weight: 700; color: #1f2d29; }
.level-tag { padding: 4rpx 14rpx; border-radius: 999rpx; background: #e6f7f0; color: #0ea56b; font-size: 20rpx; font-weight: 700; }
.candidate-reason { display: block; margin-top: 10rpx; font-size: 25rpx; color: #666; line-height: 1.5; }
.candidate-meta { display: block; margin-top: 8rpx; font-size: 22rpx; color: #84938e; }
.check-mark { width: 44rpx; height: 44rpx; border-radius: 50%; border: 2rpx solid rgba(18,69,51,0.14); color: #fff; font-size: 26rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; background: transparent; }
.candidate-card.selected .check-mark { background: linear-gradient(135deg, #0ea56b, #0b8f61); border-color: transparent; }
.invite-actions { margin-top: 24rpx; }
.btn-generate { width: 100%; height: 92rpx; border-radius: 999rpx; background: linear-gradient(135deg, #0ea56b, #0b8f61); color: #fff; border: none; font-size: 30rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.btn-generate.disabled { opacity: 0.6; }
.invite-list { margin-top: 28rpx; padding: 26rpx 24rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.invite-head { display: flex; justify-content: space-between; margin-bottom: 20rpx; }
.section-title { font-size: 30rpx; font-weight: 700; color: #1f2d29; }
.section-caption { font-size: 23rpx; color: #84938e; margin-top: 6rpx; }
.template-tag { padding: 6rpx 16rpx; border-radius: 999rpx; background: #fff8e8; color: #b56f12; font-size: 20rpx; font-weight: 700; }
.invite-item { display: flex; align-items: stretch; gap: 16rpx; padding: 20rpx; border-radius: 18rpx; background: #f7fbf9; margin-bottom: 14rpx; }
.invite-content { flex: 1; min-width: 0; }
.invite-name { display: block; font-size: 26rpx; font-weight: 700; color: #0ea56b; margin-bottom: 8rpx; }
.invite-text { display: block; font-size: 25rpx; line-height: 1.7; color: #666; word-break: break-all; }
.btn-copy { width: 116rpx; height: 64rpx; border-radius: 999rpx; background: linear-gradient(135deg, #0ea56b, #0b8f61); color: #fff; border: none; font-size: 24rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; align-self: flex-end; }
.share-bar { margin-top: 24rpx; }
.btn-share { width: 100%; height: 92rpx; border-radius: 999rpx; background: linear-gradient(135deg, #eaf3ff, #dcebff); color: #2d73c8; border: 2rpx solid rgba(45,115,200,0.18); font-size: 30rpx; font-weight: 700; }
.empty-tip { text-align: center; padding: 60rpx 20rpx; }
.empty-icon { font-size: 60rpx; display: block; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; font-weight: 700; color: #54635e; display: block; }
.empty-desc { font-size: 24rpx; color: #84938e; display: block; margin-top: 12rpx; }

/* ===== T33 AI 未开启提示 ===== */
.generate-off-tip { text-align: center; font-size: 26rpx; color: #84938e; padding: 24rpx; background: #f4f7f6; border-radius: 12rpx; }

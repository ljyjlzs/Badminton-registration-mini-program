.page-shell { padding: 24rpx; }
.report-hero { background: linear-gradient(135deg, #0ea56b, #0b8f61); border-radius: 24rpx; padding: 40rpx 30rpx; margin-bottom: 24rpx; text-align: center; }
.report-title { font-size: 36rpx; font-weight: 800; color: #fff; display: block; }
.report-subtitle { font-size: 26rpx; color: rgba(255,255,255,0.8); display: block; margin-top: 12rpx; }
.stat-cards { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16rpx; margin-bottom: 24rpx; }
.stat-card { background: #fff; border-radius: 20rpx; padding: 24rpx; text-align: center; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05); }
.stat-num { display: block; font-size: 36rpx; font-weight: 800; color: #0ea56b; }
.stat-label { display: block; font-size: 22rpx; color: #84938e; margin-top: 8rpx; }
.info-card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05); }
.info-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 28rpx; color: #666; }
.info-value { font-size: 28rpx; font-weight: 600; color: #1f2d29; max-width: 60%; text-align: right; }
.btn-share { background: #0ea56b; color: #fff; border-radius: 999rpx; font-size: 30rpx; font-weight: 700; padding: 24rpx 0; }
.btn-share:active { opacity: 0.85; }

/* ===== T14 ===== */
.report-status-badge {
  display: inline-flex;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.status-registering { background: rgba(255,255,255,0.2); color: #fff; }
.status-playing { background: rgba(255,255,255,0.2); color: #fff; }
.status-finished { background: rgba(255,255,255,0.2); color: #fff; }

.badge-section { margin-bottom: 24rpx; }
.badge-list {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}
.badge-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.badge-icon { font-size: 36rpx; }
.badge-name { font-size: 22rpx; color: #1f2d29; font-weight: 600; }

.report-btns { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn-regenerate {
  flex: 1;
  background: #f0f7f4;
  color: #0ea56b;
  border: 2rpx solid rgba(14,165,107,0.2);
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 24rpx 0;
}
.btn-regenerate:active { background: #e6f3ed; }

/* ===== T14 四态状态机 ===== */
.status-card { text-align: center; padding: 60rpx 28rpx; background: #fff; border-radius: 24rpx; margin-bottom: 24rpx; }
.status-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.status-title { font-size: 32rpx; font-weight: 700; color: #1f2d29; margin-bottom: 12rpx; }
.status-desc { font-size: 26rpx; color: #84938e; }
.btn-regen { margin-top: 24rpx; background: #0ea56b; color: #fff; border-radius: 999rpx; height: 88rpx; line-height: 88rpx; font-size: 30rpx; font-weight: 700; border: none; }
.btn-regen[disabled] { background: #cdd7d2; }
.badge-desc { font-size: 22rpx; color: #84938e; display: block; }
.summary-entry { display: flex; align-items: center; justify-content: space-between; background: #f9fffc; border-radius: 20rpx; padding: 28rpx 24rpx; margin-top: 20rpx; }
.summary-entry-title { font-size: 28rpx; font-weight: 600; color: #0ea56b; }
.summary-entry-arrow { font-size: 32rpx; color: #ccc; }

.weather-page { padding: 24rpx; min-height: 100vh; }
.weather-loading { min-height: 100vh; display: flex; align-items: center; justify-content: center; }
.weather-card { background: linear-gradient(145deg,#f9fffc 0%,#eef7f3 100%); border-radius: 34rpx; padding: 40rpx 28rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 24rpx rgba(14,165,107,0.08); border: 1rpx solid rgba(14,165,107,0.12); text-align: center; }
.weather-city { font-size: 28rpx; color: #8d9a95; margin-bottom: 8rpx; }
.weather-temp { font-size: 72rpx; font-weight: 800; color: #12332b; }
.weather-text { font-size: 30rpx; color: #12332b; margin-top: 8rpx; }
.weather-wind { font-size: 24rpx; color: #8d9a95; margin-top: 8rpx; }
.weather-date { font-size: 24rpx; color: #8d9a95; margin-top: 12rpx; }
.suitable-tag { display: inline-flex; align-items: center; gap: 8rpx; padding: 12rpx 28rpx; border-radius: 999rpx; font-size: 28rpx; font-weight: 700; margin-top: 20rpx; }
.suitable-yes { background: linear-gradient(135deg,#ebfaf2 0%,#def3e8 100%); color: #0a7d52; }
.suitable-caution { background: linear-gradient(135deg,#fff6e8 0%,#ffecc4 100%); color: #c98517; }
.suitable-poor { background: rgba(255,245,245,0.98); color: #d64545; }
.detail-section { background: rgba(255,255,255,0.96); padding: 30rpx 26rpx; border-radius: 30rpx; margin-bottom: 24rpx; border: 1rpx solid rgba(18,69,51,0.06); }
.section-title { display: block; font-size: 32rpx; font-weight: 700; color: #12332b; margin-bottom: 20rpx; }
.setting-row { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid rgba(18,69,51,0.06); }
.setting-row:last-child { border-bottom: none; }
.setting-label { font-size: 28rpx; color: #12332b; }
.setting-value { font-size: 28rpx; color: #0a7d52; font-weight: 600; }
.btn-refresh { width: 100%; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 999rpx; font-size: 30rpx; font-weight: 700; background: linear-gradient(135deg,#0ea56b 0%,#0bc278 100%); color: #fff; border: none; margin-top: 16rpx; }
.empty-tip { padding: 32rpx; text-align: center; font-size: 26rpx; color: #8d9a95; }

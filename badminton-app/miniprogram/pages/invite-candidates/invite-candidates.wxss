.invite-page { padding: 24rpx; min-height: 100vh; }
.invite-loading { min-height: 100vh; display: flex; align-items: center; justify-content: center; }
.detail-section { background: rgba(255,255,255,0.96); padding: 30rpx 26rpx; border-radius: 30rpx; margin-bottom: 24rpx; border: 1rpx solid rgba(18,69,51,0.06); box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04); }
.section-title { display: block; font-size: 32rpx; font-weight: 700; color: #12332b; margin-bottom: 20rpx; }
.candidate-item { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid rgba(18,69,51,0.06); }
.candidate-item:last-child { border-bottom: none; }
.candidate-check { width: 40rpx; height: 40rpx; border-radius: 50%; border: 2rpx solid rgba(18,69,51,0.2); display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff; flex-shrink: 0; }
.candidate-check.checked { background: linear-gradient(135deg,#0ea56b,#0bc278); border-color: transparent; }
.candidate-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 700; color: #fff; background: linear-gradient(135deg,#0ea56b,#0bc278); flex-shrink: 0; }
.candidate-info { flex: 1; }
.candidate-name { font-size: 28rpx; font-weight: 600; color: #12332b; }
.candidate-meta { font-size: 22rpx; color: #8d9a95; margin-top: 4rpx; }
.candidate-reason { font-size: 22rpx; color: #8d9a95; margin-top: 4rpx; font-style: italic; }
.btn-generate { width: 100%; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 999rpx; font-size: 30rpx; font-weight: 700; background: linear-gradient(135deg,#536ff3 0%,#6b53c5 100%); color: #fff; border: none; margin-top: 16rpx; }
.btn-generate:disabled { opacity: 0.5; }
.invite-card { padding: 24rpx; border-radius: 24rpx; background: linear-gradient(135deg,#f7fbf9 0%,#f1f7f4 100%); border: 1rpx solid rgba(18,69,51,0.05); margin-bottom: 12rpx; }
.invite-name { font-size: 28rpx; font-weight: 600; color: #12332b; margin-bottom: 8rpx; }
.invite-content { font-size: 26rpx; color: #4a5e56; line-height: 1.6; }
.btn-copy { font-size: 22rpx; color: #0ea56b; padding: 8rpx 16rpx; border-radius: 999rpx; background: rgba(231,247,239,0.96); border: none; margin-top: 8rpx; }
.empty-tip { padding: 32rpx; text-align: center; font-size: 26rpx; color: #8d9a95; }

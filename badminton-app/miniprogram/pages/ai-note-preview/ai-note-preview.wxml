<view class="note-page">
  <view class="loading" wx:if="{{loading}}">生成中...</view>
  <block wx:if="{{!loading}}">
    <view class="title">{{title}}</view>
    <view class="content">{{note}}</view>
    <view class="source" wx:if="{{source}}">来源：{{source === 'ai' ? 'AI生成' : '模板'}}</view>
    <view class="btn-row" style="display:flex;gap:16rpx;margin-bottom:16rpx;">
      <view class="btn-adopt" bindtap="adopt" style="flex:1;height:72rpx;line-height:72rpx;text-align:center;border-radius:36rpx;background:#0ea56b;color:#fff;">采用</view>
      <view class="btn-reject" bindtap="reject" style="flex:1;height:72rpx;line-height:72rpx;text-align:center;border-radius:36rpx;background:#eee;color:#666;">不用</view>
      <view class="btn-retry" bindtap="retry" style="flex:1;height:72rpx;line-height:72rpx;text-align:center;border-radius:36rpx;background:#1989fa;color:#fff;">重试</view>
    </view>
    <view class="btn-copy" bindtap="copy">复制文案</view>
    <view class="tip">AI小记可在活动详情页重新生成</view>
  </block>
</view>

.note-page { padding: 30rpx; }
.title { font-size: 34rpx; font-weight: bold; margin-bottom: 20rpx; color: #1f2d29; }
.content { font-size: 30rpx; line-height: 1.6; color: #333; white-space: pre-wrap; background: #f5f8f7; padding: 24rpx; border-radius: 12rpx; }
.source { font-size: 24rpx; color: #73867f; margin-top: 16rpx; }
.btn-copy { background: #0ea56b; color: #fff; text-align: center; padding: 22rpx; border-radius: 44rpx; margin-top: 30rpx; font-size: 30rpx; }
.tip { text-align: center; color: #999; font-size: 24rpx; margin-top: 20rpx; }
.loading { text-align: center; color: #999; padding: 60rpx 0; }

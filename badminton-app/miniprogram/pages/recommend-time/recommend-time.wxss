.recommend-page { padding: 24rpx; min-height: 100vh; }
.recommend-loading { min-height: 100vh; display: flex; align-items: center; justify-content: center; }
.detail-section { background: rgba(255,255,255,0.96); padding: 30rpx 26rpx; border-radius: 30rpx; margin-bottom: 24rpx; border: 1rpx solid rgba(18,69,51,0.06); box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04); }
.section-title { display: block; font-size: 32rpx; font-weight: 700; color: #12332b; margin-bottom: 20rpx; }
.time-card { padding: 24rpx; border-radius: 24rpx; background: linear-gradient(135deg,#f7fbf9 0%,#f1f7f4 100%); border: 1rpx solid rgba(18,69,51,0.05); margin-bottom: 16rpx; }
.time-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.time-day { font-size: 30rpx; font-weight: 700; color: #12332b; }
.time-slot { font-size: 28rpx; color: #0a7d52; font-weight: 600; }
.time-rate { font-size: 24rpx; color: #8d9a95; }
.reliable-tag { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 999rpx; }
.reliable-yes { background: linear-gradient(135deg,#ebfaf2 0%,#def3e8 100%); color: #0a7d52; }
.reliable-no { background: linear-gradient(135deg,#fff6e8 0%,#ffecc4 100%); color: #c98517; }
.time-suggested { font-size: 24rpx; color: #0a7d52; margin-top: 8rpx; }
.btn-select { width: 100%; height: 72rpx; line-height: 72rpx; text-align: center; border-radius: 999rpx; font-size: 26rpx; font-weight: 700; background: linear-gradient(135deg,#0ea56b 0%,#0bc278 100%); color: #fff; border: none; margin-top: 12rpx; }
.ai-note { padding: 20rpx 24rpx; border-radius: 16rpx; background: rgba(244,247,246,0.96); font-size: 26rpx; color: #4a5e56; line-height: 1.6; margin-top: 12rpx; }
.fallback-tip { padding: 20rpx 24rpx; border-radius: 16rpx; background: linear-gradient(135deg,#fff6e8 0%,#ffecc4 100%); color: #c98517; font-size: 26rpx; text-align: center; }
.empty-tip { padding: 32rpx; text-align: center; font-size: 26rpx; color: #8d9a95; }

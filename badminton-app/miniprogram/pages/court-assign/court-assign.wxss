.court-page { min-height: 100vh; background: #f3f5f7; padding: 24rpx; box-sizing: border-box; }
.loading { text-align: center; color: #84938e; padding-top: 200rpx; font-size: 28rpx; }
.config-panel { background: #fff; border-radius: 24rpx; padding: 36rpx 32rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.panel-title { font-size: 34rpx; font-weight: 700; color: #1f2d29; }
.panel-desc { font-size: 24rpx; color: #84938e; margin: 12rpx 0 28rpx; line-height: 1.6; }
.form-item { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }
.form-label { font-size: 28rpx; color: #666; font-weight: 600; }
.form-input { width: 220rpx; text-align: center; background: #f5f5f5; border: 2rpx solid #e0e0e0; border-radius: 12rpx; padding: 14rpx; font-size: 30rpx; font-weight: 700; }
.btn-primary { background: linear-gradient(135deg, #0ea56b, #0b8f61); color: #fff; border-radius: 999rpx; font-size: 30rpx; font-weight: 700; padding: 24rpx 0; }
.organizer-bar { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 28rpx; }
.btn-mini { flex: 1; min-width: 28%; background: #fff; color: #0ea56b; border-radius: 999rpx; font-size: 26rpx; font-weight: 600; padding: 20rpx 0; text-align: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05); border: 1rpx solid rgba(14,165,107,0.2); }
.btn-mini.btn-start { background: linear-gradient(135deg, #0ea56b, #0b8f61); color: #fff; border-color: transparent; }
.court-list { display: flex; flex-direction: column; gap: 20rpx; }
.court-card { background: #fff; border-radius: 24rpx; padding: 28rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); border-left: 8rpx solid #0ea56b; }
.court-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.court-label { font-size: 32rpx; font-weight: 800; color: #1f2d29; }
.court-count { font-size: 24rpx; color: #0b7a54; font-weight: 700; background: #e6f7f0; padding: 6rpx 18rpx; border-radius: 999rpx; }
.court-del { font-size: 24rpx; color: #d64545; padding: 6rpx 16rpx; }
.member-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.member-item { display: flex; align-items: center; gap: 10rpx; background: #f5f5f5; border-radius: 999rpx; padding: 12rpx 20rpx 12rpx 12rpx; border: 1rpx solid #e8e8e8; }
.member-name { font-size: 26rpx; font-weight: 500; }
.member-level { font-size: 20rpx; color: #84938e; }
.member-move { font-size: 22rpx; color: #fff; background: #0ea56b; border-radius: 999rpx; padding: 6rpx 16rpx; font-weight: 600; }
.empty-tip { font-size: 24rpx; color: #84938e; padding: 20rpx 0; text-align: center; }
.unassigned-block { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); border-left: 8rpx solid #f2a93c; }
.block-title { font-size: 28rpx; font-weight: 700; color: #d08711; margin-bottom: 18rpx; }
.unassigned-item { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.unassigned-item:last-child { border-bottom: none; }
.unassigned-item .member-name { flex: 1; }
.unassigned-item .member-move { margin-left: auto; }
.participant-tip { text-align: center; font-size: 24rpx; color: #84938e; margin-top: 32rpx; }
.picker-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: flex-end; z-index: 50; }
.picker-content { width: 100%; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
.picker-title { font-size: 32rpx; font-weight: 700; margin-bottom: 28rpx; color: #1f2d29; }
.court-pick-list { display: flex; flex-direction: column; gap: 16rpx; max-height: 520rpx; overflow-y: auto; }
.court-pick-item { padding: 26rpx 28rpx; border-radius: 12rpx; background: #f5f5f5; font-size: 30rpx; font-weight: 600; border: 2rpx solid transparent; }
.court-pick-item.selected { background: #e6f7f0; color: #0ea56b; border-color: #0ea56b; }
.court-pick-item.disabled { opacity: 0.4; }
.picker-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.btn-cancel, .btn-confirm { flex: 1; border-radius: 999rpx; font-size: 30rpx; font-weight: 700; padding: 22rpx 0; text-align: center; }
.btn-cancel { background: #f0f0f0; color: #666; }
.btn-confirm { background: linear-gradient(135deg, #0ea56b, #0b8f61); color: #fff; }

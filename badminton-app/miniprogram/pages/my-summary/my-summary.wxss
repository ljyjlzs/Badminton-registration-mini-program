.page-shell { padding: 24rpx; }
.stat-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-bottom: 24rpx; }
.stat-card { background: #fff; border-radius: 20rpx; padding: 28rpx; text-align: center; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05); }
.stat-num { display: block; font-size: 44rpx; font-weight: 800; color: #0ea56b; }
.stat-label { display: block; font-size: 24rpx; color: #84938e; margin-top: 8rpx; }
.info-card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05); }
.info-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 28rpx; color: #666; }
.info-value { font-size: 28rpx; font-weight: 700; color: #1f2d29; }
.section-title { font-size: 32rpx; font-weight: 700; color: #1f2d29; margin-bottom: 16rpx; }
.rank-list { background: #fff; border-radius: 20rpx; overflow: hidden; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05); }
.rank-item { display: flex; align-items: center; padding: 20rpx 24rpx; border-bottom: 1rpx solid #f5f5f5; }
.rank-item:last-child { border-bottom: none; }
.rank-pos { width: 48rpx; font-size: 28rpx; font-weight: 700; color: #0ea56b; text-align: center; }
.rank-info { flex: 1; margin-left: 16rpx; }
.rank-name { font-size: 28rpx; font-weight: 600; color: #1f2d29; }
.rank-meta { font-size: 22rpx; color: #84938e; display: block; margin-top: 4rpx; }
.rank-score { font-size: 28rpx; font-weight: 700; color: #0ea56b; }

/* ===== T12-T13 ===== */
.period-switch {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  background: #f0f7f4;
  border-radius: 999rpx;
  padding: 4rpx;
}
.period-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666;
  font-weight: 600;
}
.period-item.selected {
  background: #0ea56b;
  color: #fff;
}

.ai-style-card {
  background: linear-gradient(145deg, #f9fffc 0%, #eef7f3 100%);
  border: 1rpx solid rgba(14,165,107,0.12);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.ai-style-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.ai-style-icon { font-size: 32rpx; }
.ai-style-title { font-size: 28rpx; font-weight: 700; color: #1f2d29; }
.ai-style-desc { font-size: 26rpx; color: #333; line-height: 1.6; }

.badge-section { margin-bottom: 24rpx; }
.badge-list {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}
.badge-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.badge-icon { font-size: 36rpx; }
.badge-name { font-size: 22rpx; color: #1f2d29; font-weight: 600; }

.rank-section { margin-top: 24rpx; }

/* ===== T28 统计动态化 ===== */
.stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-bottom: 24rpx; }
.stat-value { display: block; font-size: 44rpx; font-weight: 800; color: #0ea56b; }
.stat-sub { display: block; font-size: 22rpx; color: #84938e; margin-top: 4rpx; }

/* ===== T29 亮点区 ===== */
.highlight-card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05); }
.highlight-list { display: flex; flex-direction: column; gap: 12rpx; }
.highlight-item { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.highlight-item:last-child { border-bottom: none; }
.highlight-label { font-size: 26rpx; color: #666; }
.highlight-value { font-size: 26rpx; font-weight: 700; color: #0ea56b; }
.highlight-desc { display: block; font-size: 22rpx; color: #84938e; margin-top: 4rpx; }

/* ===== T50 操作按钮 ===== */
.action-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.action-btn { flex: 1; height: 88rpx; line-height: 88rpx; border-radius: 999rpx; font-size: 30rpx; font-weight: 700; border: none; }
.copy-btn { background: #f0f7f4; color: #0ea56b; }
.share-btn { background: #0ea56b; color: #fff; }

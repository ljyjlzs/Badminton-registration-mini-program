.create-page {
  min-height: 100vh;
  padding-bottom: 180rpx;
}

.form-hero {
  padding: 18rpx 4rpx 26rpx;
}

.hero-badge {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(14, 165, 107, 0.1);
  color: var(--primary-dark);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-bottom: 18rpx;
}

.hero-title {
  font-size: 48rpx;
  line-height: 1.16;
  color: var(--text-primary);
  font-weight: 800;
  margin-bottom: 10rpx;
}

.hero-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.form-section {
  border-radius: 30rpx;
  padding: 34rpx 28rpx;
}

.form-title {
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(18, 69, 51, 0.06);
}

.type-toggle {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.type-btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: rgba(244, 247, 246, 0.96);
  border: 2rpx solid rgba(18, 69, 51, 0.06);
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-secondary);
  text-align: center;
}

.type-btn.active {
  background: linear-gradient(135deg, #effbf5 0%, #e5f6ee 100%);
  color: var(--primary-dark);
  border-color: rgba(14, 165, 107, 0.24);
  box-shadow: 0 10rpx 24rpx rgba(17, 181, 116, 0.12);
}

.location-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.location-input {
  flex: 1;
}

.btn-select-location {
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 34rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #effbf5 0%, #dff2e8 100%);
  color: var(--primary-dark);
  border: 2rpx solid rgba(14, 165, 107, 0.18);
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
}

.double-picker-row {
  display: flex;
  gap: 18rpx;
}

.picker-item {
  flex: 1;
}

.picker-value {
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 54rpx 0 28rpx;
  border-radius: 24rpx;
  background: rgba(244, 247, 246, 0.96);
  border: 2rpx solid transparent;
  color: var(--text-primary);
  font-size: 30rpx;
  position: relative;
  box-sizing: border-box;
}

.picker-value::after {
  content: '▾';
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-light);
  font-size: 24rpx;
}

.player-info {
  display: flex;
  gap: 14rpx;
}

.player-chip {
  flex: 1;
  padding: 22rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f8fcfa 0%, #f1f6f4 100%);
  border: 1rpx solid rgba(18, 69, 51, 0.05);
}

.player-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
}

.player-value {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 700;
}

.tip-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 30rpx;
  padding: 30rpx 28rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(18, 69, 51, 0.06);
  margin-bottom: 24rpx;
}

.tip-title {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 700;
  margin-bottom: 18rpx;
}

.tip-item {
  position: relative;
  padding-left: 20rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: var(--text-secondary);
}

.tip-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--primary-color);
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--surface-card-strong, #fff);
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.page-shell {
  padding-bottom: 180rpx;
}

.btn-submit {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 999rpx;
  background: var(--primary-gradient);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  border: none;
  box-shadow: var(--shadow-primary);
}

.btn-submit[disabled] {
  background: #cdd7d2;
  color: rgba(23, 51, 42, 0.48);
  box-shadow: none;
}

/* ===== T1-T3 ===== */
.region-picker-value {
  font-size: 28rpx;
  color: #1f2d29;
}
.player-chip-input {
  background: #f9fffc;
  border: 1rpx solid rgba(14,165,107,0.16);
}
.player-input-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.player-input {
  width: 120rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #0ea56b;
}
.player-unit {
  font-size: 26rpx;
  color: #666;
}
.form-hint {
  font-size: 24rpx;
  color: #84938e;
  margin-top: 8rpx;
}

/* ===== T19 AI 顶部输入框 ===== */
.ai-entry { display: flex; align-items: center; gap: 16rpx; background: #fff; border-radius: 20rpx; padding: 16rpx 20rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.ai-entry-icon { width: 56rpx; height: 56rpx; border-radius: 50%; background: linear-gradient(135deg, #4f69f1, #6b53c5); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 700; flex-shrink: 0; }
.ai-entry-input { flex: 1; font-size: 28rpx; color: #1f2d29; }
.ai-entry-btn { height: 64rpx; line-height: 64rpx; padding: 0 24rpx; border-radius: 999rpx; background: #4f69f1; color: #fff; font-size: 26rpx; font-weight: 700; border: none; flex-shrink: 0; }

/* ===== T20 智能推荐 ===== */
.recommend-entry { margin-top: 16rpx; }
.btn-recommend { width: 100%; height: 80rpx; line-height: 80rpx; border-radius: 999rpx; background: linear-gradient(135deg, #f0f7ff 0%, #e8f4fd 100%); color: #4f69f1; font-size: 28rpx; font-weight: 700; border: 1rpx solid rgba(79,105,241,0.16); }
.recommend-panel { margin-top: 16rpx; background: #fff; border-radius: 20rpx; padding: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.recommend-panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.recommend-title { font-size: 28rpx; font-weight: 700; color: #1f2d29; }
.recommend-close { font-size: 26rpx; color: #84938e; }
.recommend-loading { text-align: center; padding: 32rpx; color: #84938e; font-size: 26rpx; }
.recommend-ainote { font-size: 24rpx; color: #4f69f1; padding: 12rpx 16rpx; background: #f0f7ff; border-radius: 12rpx; margin-bottom: 12rpx; }
.recommend-fallback { font-size: 24rpx; color: #e65100; padding: 12rpx 16rpx; background: #fff3e0; border-radius: 12rpx; margin-bottom: 12rpx; }
.recommend-card { padding: 20rpx; border-radius: 16rpx; background: #f9fffc; border: 1rpx solid rgba(14,165,107,0.1); margin-bottom: 12rpx; }
.recommend-card:active { background: #f0f7f4; }
.recommend-card-main { display: flex; justify-content: space-between; align-items: center; }
.recommend-week { font-size: 28rpx; font-weight: 600; color: #1f2d29; }
.recommend-time { font-size: 28rpx; font-weight: 700; color: #0ea56b; }
.recommend-card-sub { font-size: 22rpx; color: #84938e; margin-top: 8rpx; }
.recommend-reason { font-size: 22rpx; color: #4a5e56; margin-top: 8rpx; padding: 8rpx 12rpx; background: #f4f7f6; border-radius: 8rpx; }
.recommend-empty { text-align: center; padding: 32rpx; color: #84938e; font-size: 26rpx; }

/* ===== 弹窗与表单公共样式（页面局部补充，避免引用未定义类） ===== */
.picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(12, 33, 26, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(10rpx);
}

.ai-dialog {
  width: 86%;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.12);
}

.ai-dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.ai-dialog-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2d29;
}

.ai-dialog-close {
  font-size: 34rpx;
  color: #84938e;
  padding: 4rpx 12rpx;
}

.ai-dialog-body {
  margin-bottom: 28rpx;
}

.ai-dialog-hint {
  font-size: 26rpx;
  color: #4a5e56;
  margin-bottom: 12rpx;
}

.ai-dialog-example {
  font-size: 24rpx;
  color: #84938e;
  background: #f4f7f6;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}

.ai-dialog-input {
  width: 100%;
  min-height: 140rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  background: #f8fcfa;
  border: 1rpx solid rgba(14, 165, 107, 0.16);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1f2d29;
  line-height: 1.6;
}

.ai-dialog-footer {
  display: flex;
  gap: 16rpx;
}

.ai-dialog-btn-cancel,
.ai-dialog-btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}

.ai-dialog-btn-cancel {
  background: #f4f7f6;
  color: #4a5e56;
}

.ai-dialog-btn-confirm {
  background: linear-gradient(135deg, #4f69f1, #6b53c5);
  color: #fff;
}

.ai-section { margin-bottom: 24rpx; }
.ai-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.ai-bar-icon { font-size: 36rpx; flex-shrink: 0; }
.ai-bar-text { flex: 1; }
.ai-bar-title { font-size: 28rpx; font-weight: 700; color: #1f2d29; }
.ai-bar-desc { font-size: 22rpx; color: #84938e; margin-top: 4rpx; }
.ai-bar-arrow { font-size: 32rpx; color: #c5cfcb; flex-shrink: 0; }

.preview-page { min-height: 100vh; background: #f3f5f7; }
.preview-loading { min-height: 100vh; }
.preview-shell { padding: 24rpx 24rpx 160rpx; }
.preview-hero { display: flex; justify-content: space-between; align-items: stretch; gap: 18rpx; margin-bottom: 24rpx; padding: 32rpx 30rpx; border-radius: 30rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.hero-copy { flex: 1; }
.hero-badge { display: inline-flex; padding: 10rpx 18rpx; border-radius: 999rpx; background: #e6f7f0; color: #0ea56b; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; margin-bottom: 18rpx; }
.hero-title { font-size: 40rpx; font-weight: 800; color: #1f2d29; margin-bottom: 10rpx; }
.hero-subtitle { font-size: 25rpx; color: #84938e; }
.hero-stat-card { min-width: 150rpx; padding: 18rpx 16rpx; border-radius: 24rpx; background: #f4f8f6; text-align: center; }
.stat-num { font-size: 44rpx; font-weight: 800; color: #0ea56b; display: block; }
.stat-label { font-size: 22rpx; color: #84938e; display: block; margin-top: 8rpx; }
.rules-card, .teams-card { background: #fff; border-radius: 28rpx; padding: 28rpx 26rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.section-title { font-size: 32rpx; font-weight: 700; color: #1f2d29; }
.section-caption { font-size: 24rpx; color: #84938e; margin-top: 8rpx; }
.rule-item { display: flex; align-items: flex-start; gap: 14rpx; margin-top: 18rpx; }
.rule-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #0ea56b; margin-top: 12rpx; flex-shrink: 0; }
.rule-text { flex: 1; font-size: 26rpx; line-height: 1.7; color: #666; }
.teams-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24rpx; }
.teams-count { padding: 8rpx 18rpx; border-radius: 999rpx; background: #f4f8f6; font-size: 24rpx; color: #666; font-weight: 600; }
.team-list { display: flex; flex-direction: column; gap: 16rpx; }
.team-card { padding: 24rpx; border-radius: 22rpx; background: #f7fbf9; border: 1rpx solid rgba(18,69,51,0.06); }
.team-head { display: flex; align-items: center; gap: 16rpx; }
.team-index { width: 56rpx; height: 56rpx; border-radius: 16rpx; background: linear-gradient(135deg, #0ea56b, #0b8f61); color: #fff; font-size: 26rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.team-copy { flex: 1; }
.team-members { font-size: 30rpx; font-weight: 700; color: #1f2d29; }
.team-levels { font-size: 23rpx; color: #84938e; display: block; margin-top: 8rpx; }
.empty-tip { text-align: center; padding: 48rpx 20rpx; }
.empty-icon { font-size: 48rpx; display: block; margin-bottom: 12rpx; }
.empty-text { font-size: 28rpx; font-weight: 700; color: #54635e; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 16rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,0.98); border-top: 1rpx solid rgba(18,69,51,0.06); box-shadow: 0 -8rpx 24rpx rgba(26,40,35,0.06); }
.btn-cancel, .btn-confirm { flex: 1; height: 92rpx; border-radius: 999rpx; font-size: 30rpx; font-weight: 700; border: none; display: flex; align-items: center; justify-content: center; }
.btn-cancel { background: #f4f8f6; color: #666; }
.btn-confirm { background: linear-gradient(135deg, #0ea56b, #0b8f61); color: #fff; box-shadow: 0 4rpx 12rpx rgba(14,165,107,0.3); }
.btn-confirm[disabled] { background: #cdd7d2; color: rgba(23,51,42,0.48); box-shadow: none; }

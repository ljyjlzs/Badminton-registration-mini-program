.match-reminder {
  background: linear-gradient(135deg, #eefbf5 0%, #def3e8 100%);
  border: 1rpx solid rgba(14, 165, 107, 0.16);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.reminder-current, .reminder-next {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
}
.reminder-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ccc;
  flex-shrink: 0;
}
.reminder-dot.live {
  background: #0ea56b;
  box-shadow: 0 0 8rpx rgba(14, 165, 107, 0.5);
}
.reminder-text {
  font-size: 26rpx;
  color: #1f2d29;
  font-weight: 600;
}
.reminder-next .reminder-text {
  color: #666;
  font-weight: 500;
}

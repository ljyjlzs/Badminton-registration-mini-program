.ai-suggestion {
  background: linear-gradient(135deg, #eefbf5 0%, #def3e8 100%);
  border: 1rpx solid rgba(14, 165, 107, 0.16);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.ai-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}
.ai-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #0ea56b;
}
.ai-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #0b7a54;
}
.ai-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.ai-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 18rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}
.ai-arrow {
  color: #0ea56b;
  font-size: 24rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}
